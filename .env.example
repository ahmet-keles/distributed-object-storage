# Copy to .env and fill in local values: cp .env.example .env
# Shared by Docker Compose and by metadata-service when run on the host.

# metadata-service database (compose service: metadata-db)
METADATA_POSTGRES_DB=objectstore
METADATA_POSTGRES_USER=objectstore_user
METADATA_POSTGRES_PASSWORD=change_me
METADATA_POSTGRES_HOST=127.0.0.1
METADATA_POSTGRES_PORT=5433
